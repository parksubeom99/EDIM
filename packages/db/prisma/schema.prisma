// EDIM L1 data model. See handoff §4.
//
// Principles baked in here:
//  - stable_id / revision_id separation on hierarchy_node (identity vs version).
//  - tenant_id on every tenant-scoped table (RLS scope column).
// RLS policies and the non-superuser app role are NOT expressible in Prisma
// schema — they live in the hand-written migration 0002_rls. This schema is the
// source of truth for the generated client and the table shapes; the DDL in
// migration 0001_init is kept in lockstep with it by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships     Membership[]
  hierarchyNodes  HierarchyNode[]
  auditLogs       AuditLog[]
  macroRegistries MacroRegistry[]
  projects        Project[]
  attachments     ProjectAttachment[]
  tasks           ProjectTask[]
  approvals       ProjectApproval[]
  codeRevisions   CodeRevision[]
  subCodes        SubCode[]
  productCodes    ProductCode[]
  codeRelations   CodeRelationship[]
  bomCodeRuns     BomCodeRun[]
  platformReqs    PlatformRequest[]
  drawings        Drawing[]
  documents       Document[]
  purchaseReqs    PurchaseRequest[]
  purchaseLines   PurchaseRequestLine[]
  printSetups     PrintSetup[]
  uiForms         UiForm[]
  priceHistory    PriceHistory[]
  arrangementCodes ArrangementCode[]
  specItems       SpecItem[]
  partners        Partner[]
  inputItems      InputItem[]
  projectContacts ProjectContact[]
  projectActivities ProjectActivity[]
  attachments2    Attachment[]
  mfgRates        MfgRate[]
  erpMasters      ErpMaster[]
  drawingTemplateItems DrawingTemplateItem[]
  outputItems     OutputItem[]
  graphDefs       GraphDef[]
  tableMetas      TableMeta[]
  printLayouts    PrintLayout[]
  drawingAnnotations DrawingAnnotation[]

  @@map("tenant")
}

model AppUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String
  /// 0032 · p11 — scrypt$N$r$p$salt$hash. NULL = 비밀번호 없는 계정(EDIM_DEV_LOGIN=1 일 때만 이메일로)
  passwordHash String? @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships        Membership[]
  createdNodes       HierarchyNode[]
  auditActions       AuditLog[]
  macrosCreated      MacroRegistry[]     @relation("MacroCreator")
  macrosApproved     MacroRegistry[]     @relation("MacroApprover")
  createdProjects    Project[] @relation("ProjectCreator")
  ownedProjects      Project[] @relation("ProjectOwner")
  uploadedFiles      ProjectAttachment[]
  approvalsRequested ProjectApproval[]   @relation("ApprovalRequester")
  approvalsToDecide  ProjectApproval[]   @relation("ApprovalApprover")
  codeRevisions      CodeRevision[]
  subCodes           SubCode[]
  productCodes       ProductCode[]
  codeRelations      CodeRelationship[]
  bomCodeRuns        BomCodeRun[]
  platformReqs       PlatformRequest[]
  drawings           Drawing[]
  documents          Document[]
  purchaseReqs       PurchaseRequest[]

  @@map("app_user")
}

model Membership {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("membership")
}

model HierarchyNode {
  stableId     String   @default(dbgenerated("gen_random_uuid()")) @map("stable_id") @db.Uuid
  revisionId   String   @default(dbgenerated("gen_random_uuid()")) @map("revision_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentStable String?  @map("parent_stable") @db.Uuid
  kind         String
  label        String
  position     Int
  isCurrent    Boolean  @default(true) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String   @map("created_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator AppUser @relation(fields: [createdBy], references: [id])

  @@id([stableId, revisionId])
  @@index([tenantId, parentStable, position])
  @@map("hierarchy_node")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  tenantId String   @map("tenant_id") @db.Uuid
  actorId  String   @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String   @map("entity_id")
  before   Json?    @db.JsonB
  after    Json?    @db.JsonB
  at       DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  AppUser @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

// STEP 5 Registry: approved-macro store (A7). One active `approved` macro per
// node (stable_id) + revision history; a new approval supersedes the prior one.
// `stable_id` is a SOFT reference to hierarchy_node identity — that table's PK
// is composite (stable_id + revision_id) so a plain FK is not expressible; RLS
// guarantees same-tenant. Mirrors HierarchyNode.parentStable.
model MacroRegistry {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  stableId           String    @map("stable_id") @db.Uuid
  dsl                String
  status             String    @default("draft")
  revision           Int       @default(1)
  verifiedAtApproval Boolean   @default(false) @map("verified_at_approval")
  createdBy          String    @map("created_by") @db.Uuid
  approvedBy         String?   @map("approved_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator  AppUser  @relation("MacroCreator", fields: [createdBy], references: [id])
  approver AppUser? @relation("MacroApprover", fields: [approvedBy], references: [id])

  @@index([tenantId, stableId, status])
  @@map("macro_registry")
}

// --- L3 Phase A: Project Management (handoff §3.1) --------------------------
// Project is the detail table for a Hierarchy node of kind='project'
// (Hierarchy = address, table = detail). `hierarchyStable` points at the node's
// stable_id; it is NOT a code column — project_no is a human-readable number,
// not an RCCS code (GAP1 stays untouched).

model Project {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  hierarchyStable String   @map("hierarchy_stable") @db.Uuid
  projectNo       String   @map("project_no")
  name            String
  type            String // 'client' | 'internal'
  clientName      String?  @map("client_name")
  clientContact   String?  @map("client_contact")
  itemType        String?  @map("item_type") // free text (e.g. 'AHU'), not a code
  salesStage      String   @map("sales_stage") // 기술제안|견적|협의|계약|계약변경|종료
  status          String // 'active' | 'closed'
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String   @map("created_by") @db.Uuid
  /// 0014 · p12 담당자 · Remarks · Description
  ownerId         String?  @map("owner_id") @db.Uuid
  remarks         String?
  description     String?
  /// 0021 · Company DB 고객(p64). client_name 글자 열은 그대로 둔다(옛 데이터 보존)
  clientId        String?  @map("client_id") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Partner?            @relation("ProjectClient", fields: [clientId], references: [id], onDelete: SetNull)
  creator     AppUser             @relation("ProjectCreator", fields: [createdBy], references: [id])
  owner       AppUser?            @relation("ProjectOwner", fields: [ownerId], references: [id])
  attachments ProjectAttachment[]
  tasks       ProjectTask[]
  approvals   ProjectApproval[]
  contacts    ProjectContact[]
  activities  ProjectActivity[]

  @@unique([tenantId, projectNo])
  @@index([tenantId, hierarchyStable])
  @@map("project")
}

model ProjectAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  department  String
  docType     String   @map("doc_type")
  name        String
  description String?
  fileRef     String   @map("file_ref") // 'local:<tenant>/<uuid>' = 0014 실제 파일 · 그 외 = 메타데이터만
  fileMime    String?  @map("file_mime")
  fileSize    Int?     @map("file_size")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  uploadedBy  String   @map("uploaded_by") @db.Uuid

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader AppUser @relation(fields: [uploadedBy], references: [id])

  @@index([tenantId, projectId])
  @@map("project_attachment")
}

model ProjectTask {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  title     String
  state     String // 'todo' | 'done'
  dueAt     DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("project_task")
}

model ProjectApproval {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  requesterId String    @map("requester_id") @db.Uuid
  approverId  String?   @map("approver_id") @db.Uuid
  state       String // 'requested' | 'approved' | 'rejected'
  note        String?
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  /// P6: 이 승인이 가리키는 BOM 스냅샷. 한 번 묶이면 바뀌지 않는다(DB 트리거). null = P6 이전 기록.
  bomRunId    String?   @map("bom_run_id") @db.Uuid

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomRun    BomCodeRun? @relation(fields: [bomRunId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester AppUser  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approver  AppUser? @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([tenantId, projectId])
  @@index([tenantId, bomRunId], map: "project_approval_run_idx")
  @@map("project_approval")
}

/// Tier B — RCCS 조립 코드 영속 + Revision (EDIM.pdf p24 Revisions: rev_no·rev_date·
/// rev_reason·revised_by; p12/p13 "Revision : A"). One row per save; rev_no is
/// monotonic per (tenant, node). The current code of a node = its max rev_no.
/// Nothing is ever updated in place — a correction is a new revision.
model CodeRevision {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  hierarchyStable String   @map("hierarchy_stable") @db.Uuid
  revNo           Int      @map("rev_no")
  code            String
  slots           Json     @db.JsonB
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String   @map("created_by") @db.Uuid

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator    AppUser      @relation(fields: [createdBy], references: [id])
  bomRuns    BomCodeRun[]

  @@unique([tenantId, hierarchyStable, revNo])
  @@index([tenantId, hierarchyStable])
  @@map("code_revision")
}

/// P1 — BOM Code Set-Up (EDIM.pdf p30–34). GAP1 = code-based BOM.
/// p31 Sub Code: one selectable value of one slot item (A..F) in a group.
model SubCode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  groupName   String   @map("group_name")
  itemKey     String   @map("item_key")
  itemName    String   @map("item_name")
  seq         Int
  value       String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String   @map("created_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator AppUser @relation(fields: [createdBy], references: [id])

  @@unique([tenantId, groupName, itemKey, value], map: "sub_code_tenant_group_item_value_key")
  @@unique([tenantId, groupName, itemKey, seq], map: "sub_code_tenant_group_item_seq_key")
  @@map("sub_code")
}

/// p33 Product Code: a registered code + its "Table 참조" tech tables (keyed by a slot).
model ProductCode {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String
  name             String
  kind             String // 'product' | 'part' | 'purchase'
  category         String   @default("")
  unit             String   @default("ea")
  specTemplate     String   @default("") @map("spec_template")
  materialTemplate String   @default("") @map("material_template")
  tables           Json     @default("{}") @db.JsonB
  sections         Json?    @db.JsonB
  /// 0025 · p32 Approval Status — NULL 미지정 · draft → approved → retired(역행 금지 트리거)
  approvalStatus   String?  @map("approval_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy        String   @map("created_by") @db.Uuid

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator  AppUser            @relation(fields: [createdBy], references: [id])
  children CodeRelationship[] @relation("RelParent")
  parents  CodeRelationship[] @relation("RelChild")

  @@unique([tenantId, code], map: "product_code_tenant_code_key")
  @@map("product_code")
}

/// p34 Product Code Relationship: one Child Group row.
model CodeRelationship {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  parentCode String   @map("parent_code")
  childCode  String   @map("child_code")
  seq        Int
  section    String
  qty        Json     @db.JsonB
  unitCost   Json     @map("unit_cost") @db.JsonB
  whenCond   Json?    @map("when_cond") @db.JsonB
  remarks    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String   @map("created_by") @db.Uuid

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator AppUser     @relation(fields: [createdBy], references: [id])
  parent  ProductCode @relation("RelParent", fields: [tenantId, parentCode], references: [tenantId, code], onDelete: Cascade, map: "code_relationship_parent_fkey")
  child   ProductCode @relation("RelChild", fields: [tenantId, childCode], references: [tenantId, code], onDelete: Restrict, map: "code_relationship_child_fkey")

  @@unique([tenantId, parentCode, seq], map: "code_relationship_tenant_parent_seq_key")
  @@index([tenantId, childCode], map: "code_relationship_tenant_child_idx")
  @@map("code_relationship")
}

/// BomCodeRun — the BOM is a SNAPSHOT of a code run (DATA_MODEL BOM/BOMLine
/// re-homed). Append-only: the app role has no UPDATE/DELETE on this table.
model BomCodeRun {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  hierarchyStable String?  @map("hierarchy_stable") @db.Uuid
  code            String
  slots           Json     @db.JsonB
  macroValue      Float?   @map("macro_value")
  parentCode      String   @map("parent_code")
  catalogFp       String   @map("catalog_fp")
  lines           Json     @db.JsonB
  cost            Json     @db.JsonB
  source          String   @default("workbench")
  /// P4-a: 이 BOM 을 어느 코드 개정으로 돌렸는지. null = 개정 저장 전 실행.
  codeRevisionId  String?  @map("code_revision_id") @db.Uuid
  /// P4-b: 이 값을 낸 승인 매크로와 그 개정·원문. null = 매크로 없이 돈 실행.
  macroId         String?  @map("macro_id") @db.Uuid
  macroRevision   Int?     @map("macro_revision")
  macroDsl        String?  @map("macro_dsl")
  /// 0011: 실행 시점의 Key Dimension {W,H,L,item,tableName}. null = 0011 이전 스냅샷(도면 재생성 불가).
  dims            Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String   @map("created_by") @db.Uuid

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator          AppUser           @relation(fields: [createdBy], references: [id])
  codeRevision     CodeRevision?     @relation(fields: [codeRevisionId], references: [id], onDelete: SetNull)
  drawings         Drawing[]
  documents        Document[]
  purchaseRequests PurchaseRequest[]
  approvals        ProjectApproval[]

  @@index([tenantId, hierarchyStable, createdAt(sort: Desc)], map: "bom_code_run_tenant_node_idx")
  @@map("bom_code_run")
}

/// P3-a — 회사 → 플랫폼으로 올라가는 **유일한** 통로(요청서). 업무 데이터가 아니다.
/// 회사 역할(edim_app)은 SELECT/INSERT 만, 결정 컬럼은 플랫폼 역할만 UPDATE 한다
/// (권한은 Prisma 로 표현할 수 없어 migration 0007_platform 에 있음).
model PlatformRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  kind         String
  subject      String
  payload      Json      @default("{}") @db.JsonB
  state        String    @default("requested")
  requestedBy  String    @map("requested_by") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String    @default("") @map("decision_note")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester AppUser @relation(fields: [requestedBy], references: [id])

  @@index([tenantId, requestedAt(sort: Desc)], map: "platform_request_tenant_idx")
  @@index([state, requestedAt(sort: Desc)], map: "platform_request_state_idx")
  @@map("platform_request")
}

/// P4-a — 도면(p24 "2. Drawings"). 모든 도면은 BOM 스냅샷 하나에서 나온다.
/// 발행(issued) 잠금과 상태 역행 금지는 DB 트리거가 건다(migration 0008_drawing) —
/// 앱이 깜빡해도 지켜지도록.
model Drawing {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  hierarchyStable String?  @map("hierarchy_stable") @db.Uuid
  bomRunId        String   @map("bom_run_id") @db.Uuid
  drawingNo       String   @map("drawing_no")
  drawingType     String   @map("drawing_type") // 3각법(0012): 'plan'=Top | 'front' | 'right' | 'assembly'
  scale           String   @default("1:50")
  size            String   @default("A3")
  currentRev      String   @default("A") @map("current_rev")
  status          String   @default("draft") // draft|review|approved|issued (작성중/검토/승인/발행)
  /// 0020 · 용도: approval(승인도) | manufacturing(제작도) | quotation(견적도) · NULL = 미지정(옛 도면)
  purpose         String?
  code            String
  dxf             String
  meta            Json     @default("{}") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy       String   @map("created_by") @db.Uuid

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomRun  BomCodeRun @relation(fields: [bomRunId], references: [id])
  creator AppUser    @relation(fields: [createdBy], references: [id])

  @@unique([tenantId, drawingNo, currentRev], map: "drawing_tenant_no_rev_key")
  @@index([tenantId, hierarchyStable, createdAt(sort: Desc)], map: "drawing_tenant_node_idx")
  @@map("drawing")
}

/// P4-b — 견적(PCR/Quotation, p66) · Tech Data(p15~16). 도면과 같은 규칙:
/// BOM 스냅샷 하나에서 나오고, 번호·개정·상태 4단계를 갖고, 발행되면 DB 가 잠근다.
model Document {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  hierarchyStable String?  @map("hierarchy_stable") @db.Uuid
  bomRunId        String   @map("bom_run_id") @db.Uuid
  docNo           String   @map("doc_no")
  docType         String   @map("doc_type") // 'quotation' | 'techdata'
  currentRev      String   @default("A") @map("current_rev")
  status          String   @default("draft") // draft|review|approved|issued
  code            String
  body            Json     @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy       String   @map("created_by") @db.Uuid
  /// 0030 · 발행되는 순간 박히는 인쇄 양식 버전(트리거). NULL = 발행 전이거나 양식 없음
  printLayoutId   String?  @map("print_layout_id") @db.Uuid

