/// P4-b — 구매 요청(p51). 한 BOM 스냅샷에 하나. 발주되면 DB 가 잠근다.
model PurchaseRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  hierarchyStable String?   @map("hierarchy_stable") @db.Uuid
  bomRunId        String    @map("bom_run_id") @db.Uuid
  prNo            String    @map("pr_no")
  poNo            String?   @map("po_no")
  projectNo       String?   @map("project_no")
  code            String
  status          String    @default("draft") // draft|rfq|ordered (p51 Process: 견적 요청/발주)
  requiredDate    DateTime? @map("required_date") @db.Date
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy       String    @map("created_by") @db.Uuid

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomRun  BomCodeRun            @relation(fields: [bomRunId], references: [id])
  creator AppUser               @relation(fields: [createdBy], references: [id])
  lines   PurchaseRequestLine[]

  @@unique([tenantId, prNo], map: "purchase_request_tenant_no_key")
  @@unique([tenantId, bomRunId], map: "purchase_request_tenant_run_key")
  @@index([tenantId, hierarchyStable, createdAt(sort: Desc)], map: "purchase_request_tenant_node_idx")
  @@map("purchase_request")
}

model PurchaseRequestLine {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  prId         String    @map("pr_id") @db.Uuid
  lineNo       Int       @map("line_no")
  bomLineNo    Int       @map("bom_line_no")
  childCode    String    @map("child_code")
  resolvedCode String    @map("resolved_code")
  part         String
  spec         String
  qty          Float
  unit         String
  unitPrice    Int       @map("unit_price")
  supplier     String?
