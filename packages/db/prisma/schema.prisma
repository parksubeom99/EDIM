  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pr     PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, lineNo], map: "purchase_request_line_pr_no_key")
  @@map("purchase_request_line")
}

/// 0015 · p48 Print Set-up Form — 문서 종류별 인쇄 양식(용지·방향·여백·글꼴·크기·색상·머리글/바닥글·워터마크).
